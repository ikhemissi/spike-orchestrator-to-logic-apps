// VERIFY: AzureDiagnostics JobLogs status fields and LogicAppWorkflowRuntime tracked-property fields.
let StuckAutomationJobs =
    AzureDiagnostics
    | where Category == "JobLogs"
    | summarize arg_max(TimeGenerated, ResultType) by JobId_g
    | where ResultType == "Queued"
    | where TimeGenerated <= ago(10m)
    | count;
let TimedOutWorkflowRuns =
    LogicAppWorkflowRuntime
    | where TimeGenerated >= ago(15m)
    | where WorkflowName == "wf-j3-convert-onprem"
    | where tostring(parse_json(TrackedProperties).errorCode) == "HYBRID_JOB_TIMEOUT"
    | count;
print StuckOrTimedOutJobs = toscalar(StuckAutomationJobs) + toscalar(TimedOutWorkflowRuns)
