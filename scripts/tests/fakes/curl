#!/usr/bin/env python3
import hashlib
import json
import os
import sys


args = sys.argv[1:]
config = sys.stdin.read() if "--config" in args and "-" in args else ""
if "--user" in args:
    index = args.index("--user")
    if index + 1 < len(args):
        args[index + 1] = "<redacted>"
if "user =" in config:
    args.append("--stdin-user-configured")
if "test-secret-value" in config:
    args.append("--test-password-restored")
log_path = os.environ.get("CURL_TEST_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as log_file:
        entry = {"args": args}
        if "-T" in args:
            with open(args[args.index("-T") + 1], "rb") as source_file:
                entry["sha256"] = hashlib.sha256(source_file.read()).hexdigest()
        log_file.write(json.dumps(entry) + "\n")
if "--list-only" in args:
    print(os.environ.get("CURL_TEST_LISTING", "sample.txt"))
