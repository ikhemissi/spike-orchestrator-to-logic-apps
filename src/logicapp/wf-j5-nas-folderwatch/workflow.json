{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Minute",
          "interval": "@parameters('j5RecurrenceMinutes')",
          "timeZone": "Romance Standard Time"
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        }
      }
    },
    "actions": {
      "Init_CorrelationId": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "correlationId",
              "type": "string",
              "value": "@{guid()}"
            }
          ]
        },
        "runAfter": {}
      },
      "Init_StartedAt": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "startedAt",
              "type": "string",
              "value": "@{utcNow()}"
            }
          ]
        },
        "runAfter": {
          "Init_CorrelationId": [
            "Succeeded"
          ]
        }
      },
      "Scope_Try": {
        "type": "Scope",
        "actions": {
          "List_watch_folder": {
            "type": "ServiceProvider",
            "inputs": {
              "parameters": {
                "folderPath": "@parameters('j5WatchFolder')"
              },
              "serviceProviderConfiguration": {
                "connectionName": "fileSystemNas",
                "operationId": "listFolder",
                "serviceProviderId": "/serviceProviders/FileSystem"
              }
            },
            "runAfter": {},
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT15S",
              "maximumInterval": "PT5M"
            }
          },
          "Filter_files": {
            "type": "Query",
            "inputs": {
              "from": "@body('List_watch_folder')",
              "where": "@not(item()?['isFolder'])"
            },
            "runAfter": {
              "List_watch_folder": [
                "Succeeded"
              ]
            }
          },
          "For_each_file": {
            "type": "Foreach",
            "foreach": "@body('Filter_files')",
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            },
            "runAfter": {
              "Filter_files": [
                "Succeeded"
              ]
            },
            "actions": {
              "Copy_to_processed": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "source": "@{parameters('j5WatchFolder')}\\@{items('For_each_file')?['name']}",
                    "destination": "@{parameters('j5ProcessedFolder')}\\@{items('For_each_file')?['name']}",
                    "overwrite": true
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "fileSystemNas",
                    "operationId": "copyFile",
                    "serviceProviderId": "/serviceProviders/FileSystem"
                  }
                },
                "runAfter": {},
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT15S",
                  "maximumInterval": "PT5M"
                }
              },
              "Delete_source": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "filePath": "@{parameters('j5WatchFolder')}\\@{items('For_each_file')?['name']}",
                    "skipIfFileNotPresent": true
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "fileSystemNas",
                    "operationId": "deleteFile",
                    "serviceProviderId": "/serviceProviders/FileSystem"
                  }
                },
                "runAfter": {
                  "Copy_to_processed": [
                    "Succeeded"
                  ]
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT15S",
                  "maximumInterval": "PT5M"
                }
              },
              "Track_file": {
                "type": "Compose",
                "inputs": {
                  "correlationId": "@variables('correlationId')",
                  "jobName": "J5",
                  "pattern": "P1",
                  "fileName": "@items('For_each_file')?['name']",
                  "source": "@items('For_each_file')?['path']",
                  "target": "@{parameters('j5ProcessedFolder')}\\@{items('For_each_file')?['name']}",
                  "outcome": "processed"
                },
                "runAfter": {
                  "Delete_source": [
                    "Succeeded"
                  ]
                },
                "trackedProperties": {
                  "correlationId": "@{action()?['inputs']?['correlationId']}",
                  "jobName": "@{action()?['inputs']?['jobName']}",
                  "pattern": "@{action()?['inputs']?['pattern']}",
                  "fileName": "@{action()?['inputs']?['fileName']}",
                  "source": "@{action()?['inputs']?['source']}",
                  "target": "@{action()?['inputs']?['target']}",
                  "outcome": "@{action()?['inputs']?['outcome']}"
                }
              }
            }
          },
          "Compose_summary": {
            "type": "Compose",
            "inputs": {
              "correlationId": "@variables('correlationId')",
              "job": "J5",
              "pattern": "P1",
              "outcome": "Succeeded",
              "filesProcessed": "@length(body('Filter_files'))",
              "files": "@body('Filter_files')"
            },
            "runAfter": {
              "For_each_file": [
                "Succeeded"
              ]
            },
            "trackedProperties": {
              "correlationId": "@{action()?['inputs']?['correlationId']}",
              "jobName": "@{action()?['inputs']?['job']}",
              "pattern": "@{action()?['inputs']?['pattern']}",
              "outcome": "@{action()?['inputs']?['outcome']}",
              "filesProcessed": "@{action()?['inputs']?['filesProcessed']}"
            }
          }
        },
        "runAfter": {
          "Init_StartedAt": [
            "Succeeded"
          ]
        }
      },
      "Scope_Catch": {
        "type": "Scope",
        "runAfter": {
          "Scope_Try": [
            "Failed",
            "TimedOut",
            "Skipped"
          ]
        },
        "actions": {
          "Filter_failed_actions": {
            "type": "Query",
            "inputs": {
              "from": "@result('Scope_Try')",
              "where": "@equals(item()?['status'], 'Failed')"
            }
          },
          "Report_failure": {
            "type": "Workflow",
            "inputs": {
              "host": {
                "workflow": {
                  "id": "wf-child-run-report"
                }
              },
              "body": {
                "correlationId": "@variables('correlationId')",
                "job": "J5",
                "pattern": "P1",
                "outcome": "Failed",
                "startedAt": "@variables('startedAt')",
                "finishedAt": "@utcNow()",
                "filesProcessed": 0,
                "filesSkipped": 0,
                "filesFailed": 1,
                "errors": "@body('Filter_failed_actions')"
              }
            },
            "runAfter": {
              "Filter_failed_actions": [
                "Succeeded"
              ]
            }
          },
          "Terminate_failed": {
            "type": "Terminate",
            "runAfter": {
              "Report_failure": [
                "Succeeded",
                "Failed"
              ]
            },
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "J5_FAILED",
                "message": "@{first(body('Filter_failed_actions'))?['name']}: @{first(body('Filter_failed_actions'))?['error']?['message']}"
              }
            }
          }
        }
      },
      "Scope_Finally": {
        "type": "Scope",
        "runAfter": {
          "Scope_Try": [
            "Succeeded"
          ]
        },
        "actions": {
          "Files_processed": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "greater": [
                    "@length(body('Filter_files'))",
                    0
                  ]
                }
              ]
            },
            "actions": {
              "Report_success": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflow": {
                      "id": "wf-child-run-report"
                    }
                  },
                  "body": {
                    "correlationId": "@variables('correlationId')",
                    "job": "J5",
                    "pattern": "P1",
                    "outcome": "Succeeded",
                    "startedAt": "@variables('startedAt')",
                    "finishedAt": "@utcNow()",
                    "filesProcessed": 1,
                    "filesSkipped": 0,
                    "filesFailed": 0,
                    "errors": [],
                    "details": "@outputs('Compose_summary')"
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {}
          }
        }
      }
    },
    "outputs": {},
    "parameters": {}
  },
  "kind": "Stateful"
}
